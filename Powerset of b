#include <stdio.h>

int main() {
    int b[4] = {2, 3, 1, 8};
    printf("{ }\n");
    for (int i = 0; i < 4; i++) {
        printf("{%d}\n", b[i]);
    }

    for (int i = 0; i < 4; i++) {
        for (int j = i + 1; j < 4; j++) {
            printf("{%d, %d}\n", b[i], b[j]);
        }
    }

    for (int i = 0; i < 4; i++) {
        for (int j = i + 1; j < 4; j++) {
            for (int k = j + 1; k < 4; k++) {
                printf("{%d, %d, %d}\n", b[i], b[j], b[k]);
            }
        }
    }

   
    printf("{%d, %d, %d, %d}\n", b[0], b[1], b[2], b[3]);

    return 0;
}
